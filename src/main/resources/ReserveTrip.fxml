<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="350" prefWidth="400" styleClass="background" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.ReserveTripController">

    <children>
        <VBox alignment="CENTER" layoutX="106.0" layoutY="39.0" spacing="10">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>

                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="titleLabel" stylesheets="@style.css" text="Book a Trip!" textAlignment="CENTER">
                <font>
                    <Font name="Open Sans Semibold" size="16.0" />
                </font></Label>

                <TextField fx:id="inputName" alignment="CENTER" promptText="Full name" />
                <TextField fx:id="inputCPF" alignment="CENTER" promptText="Document ID" />
                <TextField fx:id="inputAge" alignment="CENTER" promptText="Age" />
                <TextField fx:id="inputEmail" alignment="CENTER" promptText="Email" />

                <Button onAction="#handleConfirm" prefWidth="149.0" styleClass="menuBtn" stylesheets="@style.css" text="Confirm reservation">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor></Button>
                <Button onAction="#handleExit1" prefWidth="149.0" styleClass="btnExit" stylesheets="@style.css" text="Exit" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor></Button>


                <Label fx:id="labelStatus" style="-fx-text-fill: green;" text="" />
            </children>
        </VBox>
    </children>
</AnchorPane>
