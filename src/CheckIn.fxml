<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="400.0" spacing="10.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="src.CheckInController">
    <children>
        <Label text="💻 PASSENGER CHECK-IN" textFill="#333333">
            <font>
            <Font name="System Bold" size="18.0" />
            </font>
            <VBox.margin>
            <Insets bottom="10.0" top="20.0" />
            </VBox.margin>
        </Label>
        <Label text="Confirmed Passenger CPF:" textFill="#555555" />
        <TextField fx:id="txtCpf" alignment="CENTER" maxWidth="200.0" promptText="Ex: 123.456.789-00" />
        <Button mnemonicParsing="false" onAction="#handleCheckIn" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #5d00a0; -fx-text-fill: white; -fx-font-weight: bold;" text="CONFIRM CHECK-IN" />
        <Label fx:id="lblStatus" text="Awaiting CPF..." textFill="#555555">
            <font>
            <Font size="13.0" />
            </font>
            <VBox.margin>
            <Insets top="5.0" />
            </VBox.margin>
        </Label>
        <Label text="Boarded List (Stack):" textFill="#333333">
            <VBox.margin>
            <Insets top="15.0" />
            </VBox.margin>
        </Label>
        <ListView fx:id="listCheckedIn" prefHeight="200.0" prefWidth="200.0" style="-fx-border-color: #cccccc;" VBox.vgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #cccccc;" text="Close">
            <VBox.margin>
            <Insets bottom="20.0" top="10.0" />
            </VBox.margin>
        </Button>
    </children>
    <padding>
        <Insets left="20.0" right="20.0" />
    </padding>
</VBox>