<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="450.0" prefWidth="600.0" spacing="10.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="src.TripSelectionController">
    <children>
        <Label text="🗺SELECT A TRIP TO MANAGE" textFill="#333333">
            <font>
            <Font name="System Bold" size="18.0" />
            </font>
            <VBox.margin>
            <Insets bottom="10.0" top="20.0" />
            </VBox.margin>
        </Label>
        <Label text="Available Trips:" textFill="#555555">
            <VBox.margin>
            <Insets left="20.0" />
            </VBox.margin>
        </Label>
        
        <ListView fx:id="listTrips" VBox.vgrow="ALWAYS">
            <VBox.margin>
            <Insets left="20.0" right="20.0" />
            </VBox.margin>
        </ListView>
        
        <Button mnemonicParsing="false" onAction="#handleSelectTrip" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="SELECT TRIP AND CONTINUE">
            <VBox.margin>
            <Insets top="10.0" />
            </VBox.margin>
        </Button>
        <Label fx:id="lblStatus" text="Awaiting selection..." textFill="#555555">
            <font>
            <Font size="13.0" />
            </font>
            <VBox.margin>
            <Insets top="5.0" />
            </VBox.margin>
        </Label>
        <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #cccccc;" text="Close">
            <VBox.margin>
            <Insets bottom="20.0" top="5.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>
