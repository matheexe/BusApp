<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="400.0" spacing="10.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.CancelTicketController">
    <children>
        <Label text="🚫 CANCEL RESERVATION" textFill="#333333">
            <font>
            <Font name="System Bold" size="18.0" />
            </font>
            <VBox.margin>
            <Insets bottom="10.0" top="30.0" />
            </VBox.margin>
        </Label>
        <Label text="Passenger CPF:" textFill="#555555" />
        <TextField fx:id="txtCpf" alignment="CENTER" maxWidth="200.0" promptText="Enter passenger CPF to cancel" />
        
        <Button mnemonicParsing="false" onAction="#handleCancelTicket" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="CONFIRM CANCELLATION">
            <VBox.margin>
            <Insets top="20.0" />
            </VBox.margin>
        </Button>
        <Label fx:id="lblStatus" text="Awaiting input..." textFill="#555555">
            <font>
            <Font size="13.0" />
            </font>
            <VBox.margin>
            <Insets top="10.0" />
            </VBox.margin>
        </Label>
        <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #cccccc;" text="Close">
            <VBox.margin>
            <Insets bottom="20.0" top="10.0" />
            </VBox.margin>
        </Button>
    </children>
    <padding>
        <Insets left="20.0" right="20.0" />
    </padding>
</VBox>