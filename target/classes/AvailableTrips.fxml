<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="450.0" spacing="15.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.AvailableTripsController">
    <children>
        <Label text="AVAILABLE TRIPS STATUS" textFill="#333333">
            <font>
            <Font name="System Bold" size="18.0" />
            </font>
            <VBox.margin>
            <Insets bottom="5.0" top="20.0" />
            </VBox.margin>
        </Label>
        <Label alignment="CENTER" text="Real-time details of the current bus trip:" textFill="#666666" />
        
        <ListView fx:id="listStatus" VBox.vgrow="ALWAYS">
            <VBox.margin>
            <Insets left="20.0" right="20.0" />
            </VBox.margin>
        </ListView>
        
        <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #cccccc;" styleClass="btnExit" stylesheets="@style.css" text="Close">
            <VBox.margin>
            <Insets bottom="20.0" top="10.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>
