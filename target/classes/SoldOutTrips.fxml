<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="450.0" prefWidth="600.0" spacing="15.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.SoldOutTripsController">
    <children>
        <Label text="🚫 SOLD OUT TRIPS" textFill="#333333">
            <font>
            <Font name="System Bold" size="18.0" />
            </font>
            <VBox.margin>
            <Insets bottom="5.0" top="20.0" />
            </VBox.margin>
        </Label>
        <Label alignment="CENTER" text="Trips that have reached full capacity:" textFill="#666666" />
        
        <Label fx:id="lblStatus" text="Loading status..." textFill="#555555" wrapText="true">
            <font>
            <Font size="13.0" />
            </font>
            <VBox.margin>
            <Insets bottom="5.0" />
            </VBox.margin>
        </Label>
        
        <ListView fx:id="listSoldOutTrips" VBox.vgrow="ALWAYS">
            <VBox.margin>
            <Insets left="20.0" right="20.0" />
            </VBox.margin>
        </ListView>
        
        <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #cccccc;" text="Close">
            <VBox.margin>
            <Insets bottom="20.0" top="10.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>